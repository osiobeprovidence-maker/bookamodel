# CONVEX_URL: Your Convex deployment URL
VITE_CONVEX_URL="YOUR_CONVEX_URL"

# Firebase Configuration (Auth only — from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"

# Mux Video (from https://dashboard.mux.com > Access Tokens)
VITE_MUX_TOKEN_ID="YOUR_MUX_TOKEN_ID"
VITE_MUX_TOKEN_SECRET="YOUR_MUX_TOKEN_SECRET"
VITE_MUX_PLAYBACK_POLICY="signed"

# Mux Webhook (set in Convex dashboard: `npx convex env set MUX_WEBHOOK_SIGNING_SECRET your_secret`)
# MUX_WEBHOOK_SIGNING_SECRET="YOUR_MUX_WEBHOOK_SIGNING_SECRET"

# Paystack Payments (from https://dashboard.paystack.com > API Keys)
VITE_PAYSTACK_PUBLIC_KEY="YOUR_PAYSTACK_PUBLIC_KEY"

# Web Push — generate with: node -e "const c=require('crypto');const e=c.createECDH('prime256v1');e.generateKeys();console.log(e.getPublicKey().toString('base64url'));console.log(e.getPrivateKey().toString('base64url'))"
# Public key goes here (safe to ship to the browser); private key goes in Convex env: `npx convex env set VAPID_PRIVATE_KEY your_private_key`
VITE_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
